body {
  background: #0f172a;
  color: white;
  text-align: center;
  font-family: Arial;
  padding-top: 100px;
}

h1 {
  color: #38bdf8;
}

button {
  padding: 10px 20px;
  border: none;
  background: #22c55e;
  color: white;
  font-size: 16px;
  cursor: pointer;
  border-radius: 8px;
}

button:hover {
  background: #16a34a;
}
